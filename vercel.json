{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "web",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth?op=login" },
    { "source": "/api/auth/register", "destination": "/api/auth?op=register" },
    { "source": "/api/auth/me", "destination": "/api/auth?op=me" },
    { "source": "/api/auth/profile", "destination": "/api/auth?op=profile" },
    { "source": "/api/catalog/feed", "destination": "/api/catalog?op=feed" },
    { "source": "/api/catalog/browse", "destination": "/api/catalog?op=browse" },
    { "source": "/api/catalog/detail", "destination": "/api/catalog?op=detail" },
    { "source": "/api/catalog/subtitles", "destination": "/api/catalog?op=subtitles" },
    { "source": "/api/catalog/subproxy", "destination": "/api/catalog?op=subproxy" },
    { "source": "/api/catalog/glossary", "destination": "/api/catalog?op=glossary" },
    { "source": "/api/catalog/ai-search", "destination": "/api/catalog?op=aisearch" }
  ],
  "functions": {
    "api/schedules/crawl.js": {
      "maxDuration": 60,
      "experimentalTriggers": [
        { "type": "schedule/v1beta" }
      ]
    },
    "api/admin/config.js": {
      "maxDuration": 60
    },
    "api/ai/*.js": {
      "maxDuration": 60
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "schedules": {
    "catalog-auto-crawl": {
      "schedule": "0 */3 * * *",
      "timezone": "Asia/Ho_Chi_Minh",
      "function": "api/schedules/crawl"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer-when-downgrade" }
      ]
    },
    {
      "source": "/api/(auth|admin|sync|ai|party)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/api/party",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/api/catalog/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/(app\\.js|subtitles\\.js|sync\\.js|i18n\\.js|styles\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
